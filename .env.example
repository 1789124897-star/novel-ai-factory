# ── 日志 ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── 输出目录 ───────────────────────────────────────────
OUTPUT_DIR=output

# ── 小说生成 (DeepSeek API) ─────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro

DEEPSEEK_TEMPERATURE=0.85
DEEPSEEK_TOP_P=0.92
DEEPSEEK_MAX_TOKENS=12000
DEEPSEEK_PRESENCE_PENALTY=0.4
DEEPSEEK_FREQUENCY_PENALTY=0.2

# ── TTS (腾讯云) ──────────────────────────────────────
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
TENCENT_REGION=ap-guangzhou

TTS_VOICE_ID=601000
TTS_SPEED=0
TTS_VOLUME=5
TTS_SAMPLE_RATE=24000
TTS_CODEC=mp3

BGM_VOLUME_RATIO=0.3

# ── 文本分割 ──────────────────────────────────────────
MAX_SEGMENT_LENGTH=140
MIN_HOPE_LENGTH=55
MIN_FORCE_MERGE_LENGTH=35

SLEEP_BETWEEN_REQUESTS=0.2

STRONG_END=[。？！…～]
MEDIUM_SPLIT=[；：—━]
WEAK_SPLIT=[，、]

# ── 字幕转录 (TurboScribe) ────────────────────────────
TARGET_URL=https://turboscribe.ai/zh-CN/u/transcribe-audio-and-video-to-text
BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
HEADLESS=false
TIMEOUT=120
POLL_INTERVAL=1.0

# ── 水印 ──────────────────────────────────────────────
WATERMARK_AUTHOR=@作者
WATERMARK_FONT=assets/fonts/Z-SIMHEI.TTF
